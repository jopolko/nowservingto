# Cache policy — must run apache2 mod_headers + mod_expires (enabled on this box).
# index.html and corridors.json are touched daily by cron; keep them short and
# revalidating so visitors pick up new openings within ~5 min, no hard-refresh
# required. ETag/Last-Modified make the revalidate a cheap 304 when unchanged.
<IfModule mod_headers.c>
    <FilesMatch "\.(html|json)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>
    # Static assets that rarely change can sit in the browser cache for a day.
    <FilesMatch "\.(svg|png|jpg|jpeg|ico|woff2?)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
</IfModule>

RewriteEngine On

# SEO landing pages: /cuisine/{key} → cuisine/{key}.html when the file exists
# (pre-rendered by tools/inject_openings.py daily). Falls through to
# /index.html for any cuisine without a pre-rendered file (defensive).
RewriteCond %{DOCUMENT_ROOT}/cuisine/$1.html -f
RewriteRule ^cuisine/([a-z_]+)/?$ /cuisine/$1.html [L]
RewriteRule ^cuisine/([a-z_]+)/?$ /index.html [L]

# Per-listing share links: /r/{slug} → index.html
RewriteRule ^r/([\w-]+)/?$ /index.html [L]
