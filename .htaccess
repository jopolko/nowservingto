# Cache policy:
#   - HTML and JSON refresh daily; revalidate after 1 hour.
#   - General images (favicons, OG cards): 7-day cache - long enough
#     that Lighthouse stops flagging "efficient cache lifetimes" but
#     short enough that an updated favicon / og card propagates within
#     a week without a cache-bust query string.
#   - Fonts (woff/woff2): 30-day cache - they never change.
#   - Thumbnails under og/thumb/* get a 30-day cache but NOT immutable.
#     They CAN change in place when the photo-recovery cron replaces a
#     wrong-business photo (Places returned a better photo, or Street
#     View fallback succeeded). Without immutable, browsers + Cloudflare
#     revalidate via ETag on the next request - changed thumbs propagate
#     without manual purges. Tradeoff: small uptick in conditional-GET
#     bandwidth when nothing changed, in exchange for self-healing.
<IfModule mod_headers.c>
    <FilesMatch "\.(html|json)$">
        Header set Cache-Control "public, max-age=300, s-maxage=60, must-revalidate"
    </FilesMatch>
    <FilesMatch "\.(svg|png|jpg|jpeg|webp|ico)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
    <FilesMatch "\.(woff2?|ttf|otf)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>
    # JS bundle (app.js, embed.js) — cache-bust query strings on script
    # tags (e.g. /js/app.js?v=<epoch>) handle invalidation, so immutable
    # is safe. Lifts repeat-visit Lighthouse score by removing the
    # default "no cache TTL" warning.
    <FilesMatch "\.js$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>
    # robots.txt + sitemap.xml: short cache so edits propagate fast through
    # Cloudflare. Previously these inherited a multi-hour default which made
    # stale Lighthouse robots.txt validations linger after content fixes.
    <FilesMatch "\.txt$|sitemap.*\.xml$">
        Header set Cache-Control "public, max-age=300"
    </FilesMatch>
    # CORS for the public JSON feed + embed widget. Third-party sites
    # embedding the widget need to fetch /data/corridors.json cross-origin,
    # and /embed.js gets loaded into their pages. Both are explicitly
    # public, no auth, no PII.
    <FilesMatch "(corridors\.json|embed\.js)$">
        Header set Access-Control-Allow-Origin "*"
        Header set Access-Control-Allow-Methods "GET, OPTIONS"
    </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
    # Thumbnail override: must come AFTER the broad FilesMatch above so it
    # wins source-order precedence. Previous version used SetEnvIf +
    # env=LONG_CACHE but FilesMatch is more-specific than the bare
    # mod_headers context, so the FilesMatch value (7d) was winning even
    # though the env override was source-later. <If> sits at the same
    # specificity level as FilesMatch, so source order decides - and we
    # win by being last.
    <If "%{REQUEST_URI} =~ m#^/og/thumb/#">
        # 30-day cache but NOT immutable - the photo-recovery cron can
        # replace a thumb in-place if Places returns a better photo for
        # the same slug. Without "immutable", browsers + Cloudflare
        # revalidate via the ETag header (which Apache already sets) so
        # changed files propagate without manual purges.
        Header set Cache-Control "public, max-age=2592000"
    </If>
    # og.png is the site-wide social share image. It changes rarely
    # (only when the OG card design is updated) so 30-day cache is safe.
    # Unlike thumbnails, we can cache-bust via a query string if needed.
    <If "%{REQUEST_URI} =~ m#^/og\.png$#">
        Header set Cache-Control "public, max-age=2592000"
    </If>
</IfModule>

RewriteEngine On

# Reverse-proxy /api/* to the local alerts_server.py systemd service
# (subscribe / unsubscribe / tip endpoints). Requires mod_proxy +
# mod_proxy_http enabled at the server level. The [P] flag forwards
# method + body verbatim, so POSTs land intact.
RewriteRule ^api/(.*)$ http://127.0.0.1:8080/api/$1 [P,L]

# Canonicalize www → non-www. Every generated page already has a
# <link rel="canonical"> pointing at the bare-domain version, so this
# 301 makes the HTTP-level URL match the canonical declaration and
# stops Google from flagging www pages as soft-redirects.
RewriteCond %{HTTP_HOST} ^www\.nowservingto\.com$ [NC]
RewriteRule ^(.*)$ https://nowservingto.com/$1 [R=301,L]

# SEO landing pages: /cuisine/{key} → cuisine/{key}.html when present.
# This runs FIRST so that a key which gains entries tomorrow (e.g. a brand
# new "Uyghur" cuisine the validator just registered) starts serving its
# generated page automatically, even if it appears in the historical-redirect
# lists below. No fallback to /index.html for unknown keys - Apache returns
# a real 404, which Google de-indexes cleanly.
# Canonicalize to slash form first (/cuisine/key → /cuisine/key/) so the
# canonical declaration in HTML, sitemap, and HTTP URL all agree.
RewriteCond %{DOCUMENT_ROOT}/cuisine/$1.html -f
RewriteRule ^cuisine/([a-z_-]+)$ /cuisine/$1/ [R=301,L]
RewriteCond %{DOCUMENT_ROOT}/cuisine/$1.html -f
RewriteRule ^cuisine/([a-z_-]+)/?$ /cuisine/$1.html [L]

# A-Z restaurant index: /all → /all.html
RewriteRule ^all/?$ /all.html [L]

# Cuisine × district intersection pages — /cuisine/<key>/<district-slug>
# rewrites to the static file at /cuisine/<key>/<district-slug>.html
RewriteCond %{DOCUMENT_ROOT}/cuisine/$1/$2.html -f
RewriteRule ^cuisine/([a-z_-]+)/([a-z-]+)/?$ /cuisine/$1/$2.html [L]

# Canonical-alias redirects. Mirrors _CANONICAL_ALIASES in tools/cuisines.py
# (validator collapses these slugs to the seed canonical form). Preserves
# link equity from any historically-indexed alias URL.
RewriteRule ^cuisine/argentine/?$ /cuisine/argentinian [R=301,L]
RewriteRule ^cuisine/(british|irish)/?$ /cuisine/irish_uk [R=301,L]
RewriteRule ^cuisine/eastern_european/?$ /cuisine/eastern_eu [R=301,L]
RewriteRule ^cuisine/jewish/?$ /cuisine/jewish_deli [R=301,L]
RewriteRule ^cuisine/latin_american/?$ /cuisine/latin [R=301,L]
RewriteRule ^cuisine/middle_eastern/?$ /cuisine/middle_east [R=301,L]
RewriteRule ^cuisine/(gujarati|hyderabadi|maharashtrian|south_indian|north_indian|punjabi)/?$ /cuisine/indian [R=301,L]
RewriteRule ^cuisine/(hakka|indian_hakka|sichuan|southern_chinese|yunnan_chinese|indian_chinese|cantonese|hong_kong)/?$ /cuisine/chinese [R=301,L]
RewriteRule ^cuisine/(southern_italian|sicilian)/?$ /cuisine/italian [R=301,L]
RewriteRule ^cuisine/nepali/?$ /cuisine/nepalese [R=301,L]
RewriteRule ^cuisine/kurdish/?$ /cuisine/middle_east [R=301,L]
RewriteRule ^cuisine/ecuadorian/?$ /cuisine/latin [R=301,L]

# Banned labels (validator prompt forbids these as cuisine identities) - 301
# to home. Stale Google index entries from before the bans were enforced.
RewriteRule ^cuisine/(cajun|canadian|european|hawaiian|mediterranean|belgian)/?$ / [R=301,L]

# /usage → usage.html (one-pager showing per-provider API spend)
RewriteRule ^usage/?$ /usage.html [L]

# /contribute → contribute.html (Tally form for tips + corrections)
RewriteRule ^contribute/?$ /contribute.html [L]

# /press → press.html (media kit: stats, embed widget, citation format)
RewriteRule ^press/?$ /press.html [L]

# /press/data → press/data.html (data terminal for journalists)
RewriteRule ^press/data/?$ /press/data.html [L]

# /answers → answers.html (static Q&A corpus for AI assistant citation)
RewriteRule ^answers/?$ /answers.html [L]

# /game → game.html (The Toronto Dinner Lottery — shareable scratch-ticket
# that draws a real newest-opening; deep-links into /r, /cuisine, /neighborhood)
RewriteRule ^game/?$ /game.html [L]

# /neighborhood/<slug> → neighborhood/<slug>.html (iconic Toronto food
# corridors: Greektown, Little Italy, Wexford, etc.)
RewriteCond %{DOCUMENT_ROOT}/neighborhood/$1.html -f
RewriteRule ^neighborhood/([a-z-]+)/?$ /neighborhood/$1.html [L]

# /trends → trends.html (monthly cuisine-velocity chart, screenshot-shareable)
RewriteRule ^trends/?$ /trends.html [L]
# Monthly archive: /trends/2026-06 → trends/2026-06.html (immutable snapshot
# after month rollover; the X share button points at the dated URL so tweets
# stay accurate when leaderboard shifts).
RewriteCond %{DOCUMENT_ROOT}/trends/$1.html -f
RewriteRule ^trends/([0-9]{4}-[0-9]{2})/?$ /trends/$1.html [L]

# /wire/{cuisine} — editorial content merged into cuisine pages.
# All wire pages 301 to their cuisine equivalent. monica-lewis is a
# tribute page with its own identity; it keeps serving normally.
RewriteRule ^wire/afghan/?$ /cuisine/afghan [R=301,L]
RewriteRule ^wire/bangladeshi/?$ /cuisine/bangladeshi [R=301,L]
RewriteRule ^wire/caribbean/?$ /cuisine/caribbean [R=301,L]
RewriteRule ^wire/chinese/?$ /cuisine/chinese [R=301,L]
RewriteRule ^wire/colombian/?$ /cuisine/colombian [R=301,L]
RewriteRule ^wire/ethiopian/?$ /cuisine/ethiopian [R=301,L]
RewriteRule ^wire/filipino/?$ /cuisine/filipino [R=301,L]
RewriteRule ^wire/french/?$ /cuisine/french [R=301,L]
RewriteRule ^wire/greek/?$ /cuisine/greek [R=301,L]
RewriteRule ^wire/indian/?$ /cuisine/indian [R=301,L]
RewriteRule ^wire/italian/?$ /cuisine/italian [R=301,L]
RewriteRule ^wire/jamaican/?$ /cuisine/jamaican [R=301,L]
RewriteRule ^wire/japanese/?$ /cuisine/japanese [R=301,L]
RewriteRule ^wire/korean/?$ /cuisine/korean [R=301,L]
RewriteRule ^wire/lebanese/?$ /cuisine/lebanese [R=301,L]
RewriteRule ^wire/mexican/?$ /cuisine/mexican [R=301,L]
RewriteRule ^wire/middle_east/?$ /cuisine/middle_east [R=301,L]
RewriteRule ^wire/nepalese/?$ /cuisine/south_asian [R=301,L]
RewriteRule ^wire/nigerian/?$ /cuisine/nigerian [R=301,L]
RewriteRule ^wire/pakistani/?$ /cuisine/pakistani [R=301,L]
RewriteRule ^wire/persian/?$ /cuisine/persian [R=301,L]
RewriteRule ^wire/portuguese/?$ /cuisine/portuguese [R=301,L]
RewriteRule ^wire/sri_lankan/?$ /cuisine/sri_lankan [R=301,L]
RewriteRule ^wire/tamil/?$ /cuisine/tamil [R=301,L]
RewriteRule ^wire/thai/?$ /cuisine/thai [R=301,L]
RewriteRule ^wire/trinidadian/?$ /cuisine/caribbean [R=301,L]
RewriteRule ^wire/turkish/?$ /cuisine/turkish [R=301,L]
RewriteRule ^wire/vietnamese/?$ /cuisine/vietnamese [R=301,L]
# monica-lewis is a tribute page — served as-is, no redirect
RewriteCond %{DOCUMENT_ROOT}/wire/$1.html -f
RewriteRule ^wire/([a-z_-]+)/?$ /wire/$1.html [L]

# Per-district SEO landing pages: /district/{slug} → district/{slug}.html
# Canonicalize to slash form first so the canonical in HTML, sitemap, and
# HTTP URL all agree (mirrors the same two-step pattern used for /cuisine/).
RewriteCond %{DOCUMENT_ROOT}/district/$1.html -f
RewriteRule ^district/([a-z-]+)$ /district/$1/ [R=301,L]
RewriteCond %{DOCUMENT_ROOT}/district/$1.html -f
RewriteRule ^district/([a-z-]+)/?$ /district/$1.html [L]

# /dispatch/latest retired 2026-06-13 — 301 the indexed alias + bare /dispatch
# to home so neither 404s. Must precede the generic dated-archive rule below.
RewriteRule ^dispatch/latest/?$ / [R=301,L]
RewriteRule ^dispatch/?$ / [R=301,L]
# Dated monthly dispatch archive: /dispatch/{yyyy-mm} → dispatch/{yyyy-mm}.html
RewriteCond %{DOCUMENT_ROOT}/dispatch/$1.html -f
RewriteRule ^dispatch/([a-z0-9-]+)/?$ /dispatch/$1.html [L]

# Per-listing share links: /r/{slug} → r/{slug}.html when present
# (pre-rendered with per-listing title/og:image so X / FB / iMessage
# auto-card the personalized image and route the click to the listing
# page). No fallback to /index.html - a dropped/old slug must 404 so
# Google de-indexes it instead of treating it as a homepage duplicate.
RewriteCond %{DOCUMENT_ROOT}/r/$1.html -f
RewriteRule ^r/([\w-]+)/?$ /r/$1.html [L]
# A /r/{slug} whose .html no longer exists is a listing that cycled out of the
# 365-day window — intentionally, permanently removed. Return 410 Gone instead
# of the default 404 so Google de-indexes it fast and stops re-crawling it for
# months. The -f serve rule above already handled live listings ([L]), and the
# !-f guard guarantees this can never fire for a page that exists.
RewriteCond %{DOCUMENT_ROOT}/r/$1.html !-f
RewriteRule ^r/([\w-]+)/?$ - [R=410,L]
